{
  "contract": "agent-core/heartbeat",
  "version": "0.10.0",
  "title": "心跳曲线采样（固定输入 → 固定输出）",
  "authority": "android",
  "authorityNote": "规格见 docs/ROADMAP-1.9.md（心跳不由用户调参）；Android Heartbeat 是权威实现，两端公式与常量必须一致。",
  "kotlin": {
    "file": "agentcore/src/commonMain/kotlin/com/myfriend/app/domain/Heartbeat.kt",
    "symbol": "Heartbeat.probability / moodBoost / perBeatProbability / shouldFire / minutesBetween"
  },
  "swift": {
    "file": "ios/MyFriendKit/Sources/MyFriendKit/Domain/Heartbeat.swift",
    "symbol": "Heartbeat.probability / moodBoost / perBeatProbability / shouldFire / minutesBetween"
  },
  "tolerance": 1e-09,
  "inputSpec": {
    "minutesSinceReset": "距离上次互动/冲动多少分钟（负数按 0）",
    "mood": "可选 {label, intensity}；缺省 = 空心情（不放大）",
    "hourOfDay": "现在几点；0–5 点整体减半",
    "perBeat": "可选 {perMinute, intervalMinutes}：把分钟概率换算成本拍概率",
    "fire": "可选 {probability, roll}：这一拍要不要动",
    "minutesBetween": "可选 {lastResetAt, now}：时钟换算"
  },
  "cases": [
    {
      "name": "t0-initial-0.35",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.35
      }
    },
    {
      "name": "t10-cools-down",
      "input": {
        "minutesSinceReset": 10,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.11435815481690434
      }
    },
    {
      "name": "t60-starts-ramping",
      "input": {
        "minutesSinceReset": 60,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.32058824426616894
      }
    },
    {
      "name": "t180-ceiling",
      "input": {
        "minutesSinceReset": 180,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.85
      }
    },
    {
      "name": "t300-stays-at-ceiling",
      "input": {
        "minutesSinceReset": 300,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.85
      }
    },
    {
      "name": "negative-minutes-treated-as-zero",
      "input": {
        "minutesSinceReset": -5,
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.35
      }
    },
    {
      "name": "happy-mood-intensity-4-boosts",
      "why": "雀跃 4 级 → ×1.35",
      "input": {
        "minutesSinceReset": 0,
        "mood": {
          "label": "雀跃",
          "intensity": 4
        },
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.4725
      }
    },
    {
      "name": "mood-intensity-2-does-not-boost",
      "why": "强度 <3 不放大",
      "input": {
        "minutesSinceReset": 0,
        "mood": {
          "label": "雀跃",
          "intensity": 2
        },
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.35
      }
    },
    {
      "name": "calm-mood-never-boosts",
      "why": "平静（valence=0,energy=0）不放大",
      "input": {
        "minutesSinceReset": 0,
        "mood": {
          "label": "平静",
          "intensity": 5
        },
        "hourOfDay": 12
      },
      "expect": {
        "probability": 0.35
      }
    },
    {
      "name": "night-halves-probability",
      "why": "0–5 点整体减半",
      "input": {
        "minutesSinceReset": 0,
        "mood": {
          "label": "平静",
          "intensity": 4
        },
        "hourOfDay": 3
      },
      "expect": {
        "probability": 0.175
      }
    },
    {
      "name": "per-beat-from-0.35",
      "why": "30 秒一拍：1−(1−p)^0.5",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "perBeat": {
          "perMinute": 0.35,
          "intervalMinutes": 0.5
        }
      },
      "expect": {
        "probability": 0.35,
        "perBeatProbability": 0.19377422517014498
      }
    },
    {
      "name": "per-beat-defaults-interval",
      "why": "坏间隔退回 0.5 分钟",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "perBeat": {
          "perMinute": 0.35,
          "intervalMinutes": 0
        }
      },
      "expect": {
        "probability": 0.35,
        "perBeatProbability": 0.19377422517014498
      }
    },
    {
      "name": "should-fire-inside",
      "why": "roll 小于概率 → 动",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "fire": {
          "probability": 0.19377422517014498,
          "roll": 0.19
        }
      },
      "expect": {
        "probability": 0.35,
        "shouldFire": true
      }
    },
    {
      "name": "should-not-fire-outside",
      "why": "roll 不小于概率 → 不动",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "fire": {
          "probability": 0.19377422517014498,
          "roll": 0.2
        }
      },
      "expect": {
        "probability": 0.35,
        "shouldFire": false
      }
    },
    {
      "name": "should-not-fire-roll-1",
      "why": "roll 必须落在 [0,1)",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "fire": {
          "probability": 0.9,
          "roll": 1.0
        }
      },
      "expect": {
        "probability": 0.35,
        "shouldFire": false
      }
    },
    {
      "name": "minutes-between-zero",
      "why": "没有重置点 → 0",
      "input": {
        "minutesSinceReset": 0,
        "hourOfDay": 12,
        "minutesBetween": {
          "lastResetAt": 0,
          "now": 1700000000000
        }
      },
      "expect": {
        "probability": 0.35,
        "minutesBetween": 0.0
      }
    },
    {
      "name": "minutes-between-15",
      "why": "毫秒差换算成分钟",
      "input": {
        "minutesSinceReset": 15,
        "hourOfDay": 12,
        "minutesBetween": {
          "lastResetAt": 1699999100000,
          "now": 1700000000000
        }
      },
      "expect": {
        "probability": 0.12549977021267436,
        "minutesBetween": 15.0
      }
    }
  ]
}
