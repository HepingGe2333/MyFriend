      "why": "0.46 还在用",
      "input": {
        "tier": "ACTIVE",
        "pinned": false,
        "importance": 3,
        "useCount": 0,
        "lastUsedAt": 0,
        "createdAt": 0,
        "strength": 1.0,
        "lastConsolidatedAt": 0,
        "drawer": "EVENT",
        "now": 1700000000000,
        "retention": null,
        "statusStrength": 0.46
      },
      "expect": {
        "action": {
          "type": "keep"
        }
      }
    },
    {
