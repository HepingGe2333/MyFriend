    {
      "name": "dormant-old-and-faint-forgets",
      "why": "≤0.08 且 200 天没被提起 → 真删",
      "input": {
        "tier": "DORMANT",
        "pinned": false,
        "importance": 3,
        "useCount": 0,
        "lastUsedAt": 1682720000000,
        "createdAt": 0,
        "strength": 0.05,
        "lastConsolidatedAt": 0,
        "drawer": "EVENT",
