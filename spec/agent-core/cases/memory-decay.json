      "input": {
        "tier": "ACTIVE",
        "pinned": false,
        "importance": 3,
        "useCount": 0,
        "lastUsedAt": 0,
        "createdAt": 0,
        "strength": 1.0,
        "lastConsolidatedAt": 1699913600000,
        "drawer": "USER",
        "now": 1700000000000,
        "retention": null
      },
      "expect": {
        "decayStep": 0.97525
      }
    },
    {
      "name": "drawer-self-decays-middle",
      "why": "关于他自己 ×0.8",
      "input": {
        "tier": "ACTIVE",
        "pinned": false,
        "importance": 3,
        "useCount": 0,
        "lastUsedAt": 0,
        "createdAt": 0,
        "strength": 1.0,
        "lastConsolidatedAt": 1699913600000,
        "drawer": "SELF",
        "now": 1700000000000,
        "retention": null
      },
      "expect": {
        "decayStep": 0.964
      }
    },
    {
      "name": "active-low-demotes-dormant",
      "why": "≤0.45 往下一层",
      "input": {
        "tier": "ACTIVE",
        "pinned": false,
        "importance": 3,
        "useCount": 0,
        "lastUsedAt": 0,
        "createdAt": 0,
        "strength": 1.0,
        "lastConsolidatedAt": 0,
        "drawer": "EVENT",
        "now": 1700000000000,
        "retention": null,
