{
  "contract": "agent-core/proactive-cap",
  "version": "0.10.0",
  "title": "主动程度 1–5 → 每日上限 / 心跳权重 / 人话解释（心情可再挪一格）",
  "authority": "android",
  "authorityNote": "规格见 docs/ROADMAP-1.9.md §一/§三；Android ProactiveLevel + MoodBehavior.effectiveDailyCap 是权威。",
  "kotlin": {
    "file": "app/src/main/java/com/myfriend/app/domain/ProactiveLevel.kt",
    "symbol": "ProactiveLevel.normalize / dailyCap / heartbeatWeight / description；心情修正：MoodBehavior.from + effectiveDailyCap"
  },
  "swift": {
    "file": "ios/MyFriendKit/Sources/MyFriendKit/Domain/ProactiveLevel.swift",
    "symbol": "ProactiveLevel.normalize / dailyCap / heartbeatWeight / description；心情修正：MoodBehavior.from + effectiveDailyCap"
  },
  "inputSpec": {
    "level": "proactiveLevel，1–5，越界夹取",
    "mood": "可选 {label, intensity}；缺省 = 平静（不修正上限）"
  },
  "cases": [
    {
      "name": "level-1",
      "input": {
        "level": 1
      },
      "expect": {
        "normalizedLevel": 1,
        "baseDailyCap": 1,
        "dailyCap": 1,
        "heartbeatWeight": 0.7,
        "description": "很少主动。你不找他，他基本不会来打扰。"
      }
    },
    {
      "name": "level-2",
      "input": {
        "level": 2
      },
      "expect": {
        "normalizedLevel": 2,
        "baseDailyCap": 2,
        "dailyCap": 2,
        "heartbeatWeight": 0.85,
        "description": "偶尔想起你。忙起来就顾不上了。"
      }
    },
    {
      "name": "level-3-default",
      "input": {
        "level": 3
      },
      "expect": {
        "normalizedLevel": 3,
        "baseDailyCap": 3,
        "dailyCap": 3,
        "heartbeatWeight": 1.0,
        "description": "会主动，但有分寸。大多数日子会来找你说一句话。"
      }
    },
    {
      "name": "level-4",
      "input": {
        "level": 4
      },
      "expect": {
        "normalizedLevel": 4,
        "baseDailyCap": 4,
        "dailyCap": 4,
        "heartbeatWeight": 1.15,
        "description": "比较黏人。隔一阵子就想知道你在做什么。"
      }
    },
    {
      "name": "level-5",
      "input": {
        "level": 5
      },
      "expect": {
        "normalizedLevel": 5,
        "baseDailyCap": 5,
        "dailyCap": 5,
        "heartbeatWeight": 1.3,
        "description": "很黏你。一天里会好几次想找你说话。"
      }
    },
    {
      "name": "level-0-clamps-to-1",
      "input": {
        "level": 0
      },
      "expect": {
        "normalizedLevel": 1,
        "baseDailyCap": 1,
        "dailyCap": 1,
        "heartbeatWeight": 0.7,
        "description": "很少主动。你不找他，他基本不会来打扰。"
      }
    },
    {
      "name": "level-99-clamps-to-5",
      "input": {
        "level": 99
      },
      "expect": {
        "normalizedLevel": 5,
        "baseDailyCap": 5,
        "dailyCap": 5,
        "heartbeatWeight": 1.3,
        "description": "很黏你。一天里会好几次想找你说话。"
      }
    },
    {
      "name": "negative-level-clamps-to-1",
      "input": {
        "level": -3
      },
      "expect": {
        "normalizedLevel": 1,
        "baseDailyCap": 1,
        "dailyCap": 1,
        "heartbeatWeight": 0.7,
        "description": "很少主动。你不找他，他基本不会来打扰。"
      }
    },
    {
      "name": "happy-mood-raises-cap-by-one",
      "why": "雀跃/兴奋且强度 ≥3 → 上限 +1",
      "input": {
        "level": 3,
        "mood": {
          "label": "雀跃",
          "intensity": 3
        }
      },
      "expect": {
        "normalizedLevel": 3,
        "baseDailyCap": 3,
        "dailyCap": 4,
        "heartbeatWeight": 1.0,
        "description": "会主动，但有分寸。大多数日子会来找你说一句话。"
      }
    },
    {
      "name": "low-mood-lowers-cap-by-one",
      "why": "低落/累 → 上限 -1",
      "input": {
        "level": 3,
        "mood": {
          "label": "低落",
          "intensity": 4
        }
      },
      "expect": {
        "normalizedLevel": 3,
        "baseDailyCap": 3,
        "dailyCap": 2,
        "heartbeatWeight": 1.0,
        "description": "会主动，但有分寸。大多数日子会来找你说一句话。"
      }
    },
    {
      "name": "happy-mood-at-level-5-stays-5",
      "why": "上限 5 不能被心情顶到 6",
      "input": {
        "level": 5,
        "mood": {
          "label": "兴奋",
          "intensity": 5
        }
      },
      "expect": {
        "normalizedLevel": 5,
        "baseDailyCap": 5,
        "dailyCap": 5,
        "heartbeatWeight": 1.3,
        "description": "很黏你。一天里会好几次想找你说话。"
      }
    },
    {
      "name": "low-mood-at-level-1-stays-1",
      "why": "下限 1 不能被心情压到 0（主动并没有被关掉）",
      "input": {
        "level": 1,
        "mood": {
          "label": "疲惫",
          "intensity": 4
        }
      },
      "expect": {
        "normalizedLevel": 1,
        "baseDailyCap": 1,
        "dailyCap": 1,
        "heartbeatWeight": 0.7,
        "description": "很少主动。你不找他，他基本不会来打扰。"
      }
    },
    {
      "name": "calm-mood-does-not-change-cap",
      "why": "平静不修正上限",
      "input": {
        "level": 4,
        "mood": {
          "label": "平静",
          "intensity": 5
        }
      },
      "expect": {
        "normalizedLevel": 4,
        "baseDailyCap": 4,
        "dailyCap": 4,
        "heartbeatWeight": 1.15,
        "description": "比较黏人。隔一阵子就想知道你在做什么。"
      }
    },
    {
      "name": "faint-happy-mood-does-not-raise",
      "why": "强度 <3 的正面心情不顶上限",
      "input": {
        "level": 3,
        "mood": {
          "label": "雀跃",
          "intensity": 2
        }
      },
      "expect": {
        "normalizedLevel": 3,
        "baseDailyCap": 3,
        "dailyCap": 3,
        "heartbeatWeight": 1.0,
        "description": "会主动，但有分寸。大多数日子会来找你说一句话。"
      }
    }
  ]
}
